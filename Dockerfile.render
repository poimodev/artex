# Multi-stage image for Render: build the static UI, compile ARTEX, then package runtime tools.
FROM node:20-bookworm-slim AS web-build
WORKDIR /src/web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build:static

FROM golang:1.26.3-bookworm AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
COPY --from=web-build /src/web/out ./web/out
RUN mkdir -p server/webui/dist \
    && cp -R web/out/. server/webui/dist/ \
    && CGO_ENABLED=0 go build -tags embedui -o /out/artex ./cmd/artex

FROM python:3.12-slim-bookworm AS runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget vim git jq unzip ripgrep dnsutils iputils-ping \
    netcat-openbsd inetutils-telnet whois nmap gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @playwright/mcp@latest @playwright/cli@latest playwright@latest \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=go-build /out/artex /app/artex
COPY start.sh /app/start.sh
COPY skills/ /app/skills/
RUN chmod +x /app/artex /app/start.sh && mkdir -p /var/data
ENV HOME=/var/data
EXPOSE 8787 8788
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-data", "/var/data", "-proxy", "127.0.0.1:8788"]
